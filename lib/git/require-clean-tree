#!/bin/sh
# Guard: no uncommitted change, tracked or untracked.
#
# Load-bearing for the build, not just hygiene: hatch-vcs answers a dirty tree
# with a dev version rather than an error, so an unclean tree silently changes
# what gets built.
set -eu

if ! git diff --exit-code HEAD >&2; then
  echo "uncommitted changes" >&2
  exit 1
fi

untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$untracked" ]; then
  printf 'untracked files:\n%s\n' "$untracked" >&2
  exit 1
fi
