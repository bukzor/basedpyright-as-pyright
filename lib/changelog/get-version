#!/bin/sh
# Print the version at the top of CHANGELOG.md: the version a release publishes.
#
# This is the one place a version number is *authored*. The request ref states
# it as an expectation and the git tag records it afterward, but neither is
# consulted here -- see ../../docs/dev/principles.kb/single-source-of-truth.md.
set -eu

REPO="${REPO:-$(git rev-parse --show-toplevel)}"
changelog="$REPO/CHANGELOG.md"

if [ ! -f "$changelog" ]; then
  echo "no changelog: $changelog" >&2
  exit 1
fi

# The first heading naming a version. An `## Unreleased` heading above it is
# not a version, so it falls through -- which is how work-in-progress sits in
# the file without being releasable.
version="$(
  sed -n 's/^## \([0-9][0-9.]*\).*$/\1/p' "$changelog" | head -n1
)"

if [ -z "$version" ]; then
  echo "no released version heading in $changelog" >&2
  exit 1
fi

echo "$version"
